# Copy this file to .env and fill BOT_TOKEN
# cp .env-example .env

BOT_TOKEN=

# Optional settings:
# LOGS_CHAT_ID=
# MAX_FILESIZE=52428800
# WORKERS=2
# MAX_QUEUE=200
# UPLOAD_WORKERS=2
# JOB_TIMEOUT_SECONDS=900
# DEFAULT_LANGUAGE=en
# DELETE_ORIGINAL=true
# MEDIA_CACHE_ENABLED=true
# STATUS_REACTIONS=true
# DISK_CACHE_MAX_FILES=5
# DISK_CACHE_TTL_SECONDS=300
# FILE_ID_CACHE_MAX_ITEMS=500
# FILE_ID_CACHE_TTL_DAYS=30
# COOKIES_FILE=/app/data/cookies.txt
# LOG_LEVEL=INFO
# Group access policy. The installer can configure these interactively.
# GROUP_ACCESS_MODE=open
# GROUP_OWNER_USERNAME=telegram_username
# PENDING_GROUP_TTL_HOURS=168
# One-time, comma-separated seed for groups that are already trusted.
# Every ID is verified through Telegram before it is approved.
# GROUP_BOOTSTRAP_CHAT_IDS=-1001234567890,-1009876543210
# YTDLP_CONCURRENT_FRAGMENTS=4
YTDLP_JS_RUNTIMES=node
YTDLP_REMOTE_COMPONENTS=ejs:github
YTDLP_INSTAGRAM_IMPERSONATE=chrome
YTDLP_INSTAGRAM_RETRIES=8
YTDLP_INSTAGRAM_FRAGMENT_RETRIES=8
YTDLP_INSTAGRAM_SOCKET_TIMEOUT=30
YTDLP_YOUTUBE_PLAYER_CLIENTS=default,android,ios
# Legacy override (single client)
# YTDLP_YOUTUBE_PLAYER_CLIENT=
